---
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import KanitKartlari from './KanitKartlari.astro';
import { CATEGORIES, byCategory, featured, type Category, type Lang } from '../data/projects';
import { NAV, useT } from '../i18n/ui';
import { SITE } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'tr' ? 'en' : 'tr';
// Projesi olmayan kategori gösterilmez.
const cats = (Object.keys(CATEGORIES) as Category[]).filter((c) => byCategory(c).length > 0);
const projectsHref = NAV[lang].projects;
const total = cats.reduce((n, c) => n + byCategory(c).length, 0);
const stats = lang === 'tr'
  ? [[String(total), 'canlı proje'], [String(cats.length), 'alan'], ['0', 'kurulum: tarayıcıda dene']]
  : [[String(total), 'live projects'], [String(cats.length), 'areas'], ['0', 'installs: try in the browser']];
// Açılıştaki görsel kolaj: farklı alanlardan üç proje.
const kolaj = ['ivme-oneri-kaizen', 'video-zaman-etudu', 'measure-sieve'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  sameAs: [SITE.github, SITE.linkedin].filter(Boolean),
  knowsAbout: ['Warehouse operations', 'Data analysis', 'Power BI', 'SQL', 'Python', 'Lean'],
};
---
<Base lang={lang} title={SITE.title[lang]} description={SITE.description[lang]} path={NAV[lang].home} altPath={NAV[other].home} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">{t('home.kicker')}</p>
        <h1>{SITE.title[lang]}</h1>
        <p class="lead">{t('home.lead')}</p>
        <p><a class="btn primary" href={projectsHref}>{t('home.cta')}</a></p>
        <ul class="hero-stats">
          {stats.map(([v, l]) => <li><strong>{v}</strong> <span>{l}</span></li>)}
        </ul>
      </div>
      <div class="hero-kolaj" aria-hidden="true">
        {kolaj.map((slug, i) => <img class={`k${i}`} src={`/img/kart/${slug}-${lang}.webp`} alt="" width="800" height="500" fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" />)}
      </div>
    </div>
  </section>

  <KanitKartlari lang={lang} />

  <section class="wrap">
    <h2>{t('home.featured')}</h2>
    <div class="grid">{featured().map((p) => <ProjectCard project={p} lang={lang} showCategory />)}</div>
  </section>

  <section class="wrap">
    <h2>{t('home.categories')}</h2>
    <div class="grid cats">
      {cats.map((c) => (
        <a class="card cat" href={`${projectsHref}#${lang === 'tr' ? CATEGORIES[c].trSlug : CATEGORIES[c].enSlug}`}>
          <h3>{CATEGORIES[c][lang]}</h3>
          <p class="card-meta">{byCategory(c).length} {lang === 'tr' ? 'proje' : byCategory(c).length === 1 ? 'project' : 'projects'}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
