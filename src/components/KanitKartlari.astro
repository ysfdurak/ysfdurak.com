---
// "Üç projede kanıt": görsel → problem (tek cümle) → büyük sonuç → nasıl doğrulandı → bağlantılar.
// Açık kalan kısım küçük bir satır olarak yazılır (dürüstlük notu kalır, ilk izlenimi domine etmez).
import { KANITLAR } from '../data/kanit';
import type { Lang } from '../data/projects';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = lang === 'tr'
  ? { h: 'Üç projede kanıt', lead: 'Her biri çalışıyor ve nasıl doğrulandığı herkese açık. Bağlantılar test ve belgelere gider.', demo: 'Demoyu aç', proof: 'Nasıl doğrulandı', o: 'Henüz:', note: 'Kanıtlar otomatik testler ve örnek veriyle yapılan denemelerdir; bağımsız kullanıcı testi henüz yapılmadı.' }
  : { h: 'Evidence from three projects', lead: 'Each one works, and how it was verified is public. Links go to the tests and documents.', demo: 'Demo', proof: 'Verification', o: 'Not yet:', note: 'The evidence is automated tests and runs on sample data; no independent user testing yet.' };
const base = lang === 'tr' ? '/tr/projeler/' : '/en/projects/';
---
<section class="wrap kanit" aria-labelledby="kanit-h">
  <h2 id="kanit-h">{T.h}</h2>
  <p class="lead-sm">{T.lead}</p>
  <div class="kanit-grid">
    {KANITLAR.map((k) => (
      <article class="card kanit-card">
        {k.slug && <a class="card-thumb" href={`${base}${k.slug}/`} tabindex="-1" aria-hidden="true"><img src={`/img/kart/${k.slug}-${lang}.webp`} alt="" width="800" height="500" loading="lazy" decoding="async" /></a>}
        <p class="card-meta">{k.skill[lang]}</p>
        <h3>{k.slug ? <a href={`${base}${k.slug}/`}>{k.name[lang]}</a> : k.name[lang]}</h3>
        <p class="kanit-problem">{k.problem[lang]}</p>
        <div class="kanit-metric">
          <strong>{k.metric.value[lang]}</strong>
          <span>{k.metric.label[lang]}</span>
        </div>
        <p class="kanit-verified">{k.verified[lang]}</p>
        <p class="card-actions">
          <a class="card-link" href={k.example.url} rel="noopener">{T.demo} ↗</a>
          <a class="card-link" href={k.proof.url} rel="noopener">{T.proof} ↗</a>
        </p>
        {k.open && <p class="kanit-open"><span>{T.o}</span> {k.open[lang]}</p>}
      </article>
    ))}
  </div>
  <p class="kanit-not">{T.note}</p>
</section>
<style>
  .lead-sm { color: var(--ink-soft); margin: -0.4rem 0 1rem; max-width: 60ch; }
  .kanit-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); }
  .kanit-card { display: flex; flex-direction: column; }
  .kanit-card h3 { margin: 0 0 0.35rem; }
  .kanit-problem { font-size: 0.95rem; }
  .kanit-metric { margin: 0.9rem 0 0.5rem; padding: 0.7rem 0.9rem; border-radius: 8px; background: var(--bg-soft); border-left: 3px solid var(--accent); }
  .kanit-metric strong { display: block; font-size: 1.55rem; line-height: 1.15; color: var(--accent); letter-spacing: -0.01em; }
  .kanit-metric span { display: block; font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.15rem; line-height: 1.4; }
  .kanit-card .kanit-verified { font-size: 0.9rem; line-height: 1.5; }
  .kanit-card .card-actions { margin-top: auto !important; padding-top: 0.6rem; }
  .kanit-card .kanit-open { font-size: 0.82rem; border-top: 1px dashed var(--line); padding-top: 0.5rem; margin-top: 0.3rem; }
  .kanit-open span { font-weight: 600; }
  .kanit-not { font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.8rem; }
</style>
