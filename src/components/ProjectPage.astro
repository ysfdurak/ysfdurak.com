---
// Proje sayfası şablonu. TR ve EN sayfaları bu bileşeni kullanır.
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import { CATEGORIES, HOSTING_LABEL, byCategory, projectPath, type Lang, type Project } from '../data/projects';
import { NAV, useT } from '../i18n/ui';
import { SITE } from '../data/site';

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
const t = useT(lang);
const text = p[lang];
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const related = byCategory(p.category)
  .filter((x) => x.slug !== p.slug)
  .slice(0, 3);
const path = projectPath(p, lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  description: text.tagline,
  applicationCategory: 'BusinessApplication',
  operatingSystem: p.hosting === 'desktop' ? 'Windows' : 'Web',
  url: new URL(path, SITE.url).href,
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  inLanguage: lang,
};
---

<Base
  lang={lang}
  title={p.name}
  description={text.tagline}
  path={path}
  altPath={projectPath(p, other)}
  jsonLd={jsonLd}
  image={p.og}
>
  <article class="wrap project">
    <p class="crumb"><a href={NAV[lang].projects}>{t('project.back')}</a> / {CATEGORIES[p.category][lang]}</p>
    <h1>{p.name}</h1>
    <p class="lead">{text.tagline}</p>

    <div class="actions">
      {
        p.url ? (
          <a class="btn primary" href={p.url}>{t('project.try')}</a>
        ) : (
          <span class="btn disabled" aria-disabled="true">{t('project.soon')}</span>
        )
      }
      {p.repo && <a class="btn" href={p.repo}>{t('project.code')}</a>}
      <span class="tag">{HOSTING_LABEL[p.hosting][lang]}</span>
      {p.mcp && <span class="tag">MCP · {p.mcp.tools} {t('project.claudeTools')}</span>}
    </div>

    {
      p.shots && p.shots.length > 0 && (
        <figure class="shot hero-shot">
          <img src={p.shots[0].src} width={p.shots[0].w} height={p.shots[0].h} alt={p.shots[0].alt[lang]} fetchpriority="high" />
          <figcaption>{p.shots[0].alt[lang]}</figcaption>
        </figure>
      )
    }

    <section>
      <h2>{t('project.problem')}</h2>
      <p>{text.problem}</p>
    </section>

    <section>
      <h2>{t('project.solution')}</h2>
      <ul>{text.solution.map((s) => <li>{s}</li>)}</ul>
    </section>

    {
      p.demo && (
        <section>
          <h2>{t('project.demo')}</h2>
          <p>{p.demo[lang]}</p>
        </section>
      )
    }

    {
      p.mcp && (
        <section class="claude-box">
          <h2>{t('project.claude')}</h2>
          <p>{t('project.claudeLead')}</p>
          <div class="claude-grid">
            <div>
              <ol>{t('project.claudeSteps').split('|').map((x) => <li>{x}</li>)}</ol>
              <p class="mcp-url"><span>MCP</span><code>{p.mcp.url}</code></p>
              <h3>{t('project.claudeTry')}</h3>
              <ul class="prompts">{p.mcp.prompts[lang].map((x) => <li>“{x}”</li>)}</ul>
            </div>
            {p.shots && p.shots[1] && (
              <figure class="shot">
                <img src={p.shots[1].src} width={p.shots[1].w} height={p.shots[1].h} alt={p.shots[1].alt[lang]} loading="lazy" />
                <figcaption>{p.shots[1].alt[lang]}</figcaption>
              </figure>
            )}
          </div>
        </section>
      )
    }

    {
      p.shots && p.shots.length > 2 && (
        <section class="gallery">
          {p.shots.slice(2).map((sh) => (
            <figure class="shot">
              <img src={sh.src} width={sh.w} height={sh.h} alt={sh.alt[lang]} loading="lazy" />
              <figcaption>{sh.alt[lang]}</figcaption>
            </figure>
          ))}
        </section>
      )
    }

    <section>
      <h2>{t('project.tech')}</h2>
      <p class="chips">{p.tech.map((x) => <span class="tag">{x}</span>)}</p>
    </section>

    <section class="note">
      <h2>{t('project.feedback')}</h2>
      <p>{t('project.feedbackText')} <a href={`mailto:${SITE.email[lang]}?subject=${encodeURIComponent(p.name)}`}>{SITE.email[lang]}</a></p>
    </section>

    {
      related.length > 0 && (
        <section>
          <h2>{t('project.related')}</h2>
          <div class="grid">{related.map((r) => <ProjectCard project={r} lang={lang} />)}</div>
        </section>
      )
    }
  </article>
</Base>
