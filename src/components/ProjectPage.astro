---
// Proje sayfası şablonu. TR ve EN sayfaları bu bileşeni kullanır.
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import { CATEGORIES, HOSTING_LABEL, byCategory, projectPath, type Lang, type Project } from '../data/projects';
import { NAV, useT } from '../i18n/ui';
import { SITE } from '../data/site';

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
const t = useT(lang);
const text = p[lang];
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const related = byCategory(p.category)
  .filter((x) => x.slug !== p.slug)
  .slice(0, 3);
const path = projectPath(p, lang);
// EN sayfada İngilizce arayüz görüntüsü varsa onu göster.
const cs = p.caseStudy?.[lang];
const shotSrc = (sh: { src: string; srcEn?: string }) => (lang === 'en' && sh.srcEn ? sh.srcEn : sh.src);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  description: text.tagline,
  applicationCategory: 'BusinessApplication',
  operatingSystem: p.hosting === 'desktop' ? 'Windows, Web' : 'Web',
  url: new URL(path, SITE.url).href,
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  inLanguage: lang,
};
---

<Base
  lang={lang}
  title={p.name}
  description={text.tagline}
  path={path}
  altPath={projectPath(p, other)}
  jsonLd={jsonLd}
  image={lang === 'en' && p.ogEn ? p.ogEn : p.og}
>
  <article class="wrap project">
    <p class="crumb"><a href={NAV[lang].projects}>{t('project.back')}</a> / {CATEGORIES[p.category][lang]}</p>
    <h1>{p.name}</h1>
    <p class="lead">{text.tagline}</p>
    {lang === 'en' && p.turkishOnly && <p class="tr-only"><strong>Turkish interface.</strong> {p.turkishOnly.en}</p>}

    <div class="actions">
      {
        p.url ? (
          <a class="btn primary" href={lang === 'en' && p.urlEn ? p.urlEn : p.langParam ? `${p.url}?lang=${lang}` : p.url}>{t('project.try')}</a>
        ) : (
          <span class="btn disabled" aria-disabled="true">{t('project.soon')}</span>
        )
      }
      {p.download && <a class="btn" href={p.download}>{t('project.download')}</a>}
      {p.repo && <a class="btn" href={p.repo}>{t('project.code')}</a>}
      {p.repos?.map((r) => <a class="btn" href={r.url}>{t('project.code')} · {r.label}</a>)}
      <span class="tag">{HOSTING_LABEL[p.hosting][lang]}</span>
      {lang === 'en' && p.turkishOnly && <span class="tag">For Turkish speakers</span>}
      {p.mcp && <span class="tag">MCP · {p.mcp.tools} {t('project.claudeTools')}</span>}
    </div>

    {
      p.shots && p.shots.length > 0 && (
        <figure class="shot hero-shot">
          <img src={shotSrc(p.shots[0])} width={p.shots[0].w} height={p.shots[0].h} alt={p.shots[0].alt[lang]} fetchpriority="high" />
          <figcaption>{p.shots[0].alt[lang]}</figcaption>
        </figure>
      )
    }

    <section>
      <h2>{t('project.problem')}</h2>
      <p>{text.problem}</p>
    </section>

    <section>
      <h2>{t('project.solution')}</h2>
      <ul>{text.solution.map((s) => <li>{s}</li>)}</ul>
    </section>

    {
      p.video && (!p.video.lang || p.video.lang === lang) && (
        <section>
          <h2>{t('project.video')}</h2>
          <figure class="shot video">
            <video controls preload="none" playsinline poster={p.video.poster} width={p.video.w} height={p.video.h} aria-label={p.video.caption[lang]}>
              <source src={p.video.src} type="video/mp4" />
            </video>
            <figcaption>{p.video.caption[lang]}</figcaption>
          </figure>
        </section>
      )
    }

    {
      p.decisions && (
        <section>
          <h2>{t('project.decisions')}</h2>
          <ul>{p.decisions[lang].map((s) => <li>{s}</li>)}</ul>
        </section>
      )
    }

    {
      cs?.results && cs.results.length > 0 && (
        <section>
          <h2>{t('project.results')}</h2>
          <div class="results">
            {cs.results.map((r) => (
              <div class="result"><strong>{r.value}</strong><span>{r.label}</span></div>
            ))}
          </div>
        </section>
      )
    }

    {
      cs?.feedback && cs.feedback.length > 0 && (
        <section>
          <h2>{t('project.journey')}</h2>
          <ol class="journey">
            {cs.feedback.map((f) => (
              <li>
                <p class="said">“{f.said}”{(f.who || f.when) && <span class="who"> — {[f.who, f.when].filter(Boolean).join(', ')}</span>}</p>
                <p class="done"><span>{t('project.done')}</span> {f.done}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      cs?.role && (
        <section>
          <h2>{t('project.role')}</h2>
          <p>{cs.role}</p>
        </section>
      )
    }

    {
      cs?.lessons && cs.lessons.length > 0 && (
        <section>
          <h2>{t('project.lessons')}</h2>
          <ul>{cs.lessons.map((s) => <li>{s}</li>)}</ul>
        </section>
      )
    }

    {
      p.demo && (
        <section>
          <h2>{t('project.demo')}</h2>
          <p>{p.demo[lang]}</p>
          {p.method && <p><a href={p.method[lang]}>{t('project.method')} →</a></p>}
        </section>
      )
    }

    {
      p.mcp && (
        <section class="claude-box">
          <h2>{t('project.claude')}</h2>
          <p>{t('project.claudeLead')}</p>
          <div class="claude-grid">
            <div>
              <ol>{t('project.claudeSteps').split('|').map((x) => <li>{x}</li>)}</ol>
              <p class="mcp-url"><span>MCP</span><code>{p.mcp.url}</code></p>
              <h3>{t('project.claudeTry')}</h3>
              <ul class="prompts">{p.mcp.prompts[lang].map((x) => <li>“{x}”</li>)}</ul>
            </div>
            {p.shots && p.shots[1] && (
              <figure class="shot">
                <img src={shotSrc(p.shots[1])} width={p.shots[1].w} height={p.shots[1].h} alt={p.shots[1].alt[lang]} loading="lazy" />
                <figcaption>{p.shots[1].alt[lang]}</figcaption>
              </figure>
            )}
          </div>
        </section>
      )
    }

    {
      // shots[1] MCP kutusunda gösterilir; MCP yoksa galeride yer alır.
      p.shots && p.shots.length > (p.mcp ? 2 : 1) && (
        <section class="gallery">
          {p.shots.slice(p.mcp ? 2 : 1).map((sh) => (
            <figure class="shot">
              <img src={shotSrc(sh)} width={sh.w} height={sh.h} alt={sh.alt[lang]} loading="lazy" />
              <figcaption>{sh.alt[lang]}</figcaption>
            </figure>
          ))}
        </section>
      )
    }

    {
      lang === 'tr' && p.guides && p.guides.length > 0 && (
        <section>
          <h2>İlgili rehber</h2>
          <ul>{p.guides.map((g) => <li><a href={g.url}>{g.title}</a></li>)}</ul>
        </section>
      )
    }

    <section>
      <h2>{t('project.tech')}</h2>
      <p class="chips">{p.tech.map((x) => <span class="tag">{x}</span>)}</p>
      {(p.repo || p.repos) && (
        <p class="license-note">{t('project.license')} <a href={`mailto:${SITE.email[lang]}?subject=${encodeURIComponent(p.name)}`}>{SITE.email[lang]}</a></p>
      )}
    </section>

    <section class="note">
      <h2>{t('project.feedback')}</h2>
      <p>{t('project.feedbackText')} <a href={`mailto:${SITE.email[lang]}?subject=${encodeURIComponent(p.name)}`}>{SITE.email[lang]}</a></p>
    </section>

    {
      related.length > 0 && (
        <section>
          <h2>{t('project.related')}</h2>
          <div class="grid">{related.map((r) => <ProjectCard project={r} lang={lang} />)}</div>
        </section>
      )
    }
  </article>
</Base>
