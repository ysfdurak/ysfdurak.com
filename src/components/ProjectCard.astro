---
import { CATEGORIES, ENV_LABEL, HOSTING_LABEL, hasFieldResult, projectName, projectPath, tryHref, type Lang, type Project } from '../data/projects';
import { useT } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  showCategory?: boolean;
}
const { project: p, lang, showCategory = false } = Astro.props;
const t = useT(lang);
---

<article class="card">
  <a class="card-thumb" href={projectPath(p, lang)} tabindex="-1" aria-hidden="true"><img src={`/img/kart/${p.slug}-${lang}.webp`} alt="" width="640" height="400" loading="lazy" decoding="async" /></a>
  <p class="card-meta">
    {showCategory && <span>{CATEGORIES[p.category][lang]} · </span>}
    <span>{HOSTING_LABEL[p.hosting][lang]}</span>
    {lang === 'en' && p.turkishOnly && <span> · For Turkish speakers</span>}
  </p>
  <h3><a href={projectPath(p, lang)}>{projectName(p, lang)}</a></h3>
  <p>{p[lang].tagline}</p>
  <p class="card-env">{ENV_LABEL[p.env][lang]}</p>
  <p class="card-actions">
    <a class="card-link" href={projectPath(p, lang)}>{t('project.how')} →</a>
    {p.url && <a class="card-link try" href={tryHref(p, lang)}>{t('project.try')} ↗</a>}
    {p.url && <span class="card-tag">{t(hasFieldResult(p) ? 'evidence.field' : 'evidence.synthetic')}</span>}
  </p>
</article>
