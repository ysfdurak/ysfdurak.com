# Bu dosya kurulum betiği tarafından .env olarak doldurulur. .env GitHub'a girmez.
PORT=8080
# PostgreSQL bağlantısı (db-olustur.sh olcum çıktısı)
DATABASE_URL=postgres://olcum:SIFRE@postgres:5432/olcum
# Yönetim sayfası (https://olcum.ysfdurak.com/yonetim) giriş bilgileri
YONETIM_KULLANICI=yusuf
YONETIM_SIFRE=
# Olay kabul edilen kökenler (virgülle). * yalnızca alt alan adı yerine geçer.
IZINLI_KOKENLER=https://ysfdurak.com,https://*.ysfdurak.com,https://ysfdurak.github.io
# 1: her proje yalnızca projeler.json'daki kendi adresinden olay gönderebilir (önerilen)
ADRES_DENETIMI=1
# Olay ve geri bildirimler kaç gün tutulsun (7-730)
SAKLAMA_GUN=180
